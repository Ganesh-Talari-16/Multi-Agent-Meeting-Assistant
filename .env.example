# ==============================================================================
# Multi-Agent Meeting Assistant - Production Environment Variables Checklist
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="Multi-Agent Meeting Assistant"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret Key used to sign JWT access tokens. Must be a 32+ char random string in production.
SECRET_KEY="generate-a-strong-random-secret-key-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Database Settings
# ------------------------------------------------------------------------------
# Default: Local zero-config SQLite. Production: Async PostgreSQL or Managed DB URL.
DATABASE_URL="sqlite+aiosqlite:///./meeting_assistant.db"

# ------------------------------------------------------------------------------
# 4. LLM & Vector DB Integration
# ------------------------------------------------------------------------------
# Google Gemini API Key for transcript summarization, action item extraction & RAG
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="optional-openai-api-key"
CHROMADB_DIR="./chroma_db_store"
CHROMA_DB_URL="optional-external-chroma-host"

# ------------------------------------------------------------------------------
# 5. Whisper Speech & Audio Processing
# ------------------------------------------------------------------------------
WHISPER_MODEL="base"

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Client Configuration
# ------------------------------------------------------------------------------
# Allowed origins for API cross-origin security
CORS_ORIGINS=["https://multi-agent-meeting-assistant.vercel.app", "http://localhost:5173"]

# Frontend target API URL (used by Vite client)
VITE_API_BASE_URL="/api/v1"
