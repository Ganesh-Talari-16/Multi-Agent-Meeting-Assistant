# Application Configuration
APP_NAME="Multi-Agent Meeting Assistant"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="super-secret-jwt-key-change-this-in-production-mode"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./meeting_assistant.db"

# LLM & Vector DB
GEMINI_API_KEY="your-gemini-api-key-here"
CHROMADB_DIR="./chroma_db_store"

# Whisper Speech Processing
WHISPER_MODEL="base"

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
